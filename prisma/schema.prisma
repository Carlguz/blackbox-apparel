// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model SiteContent {
  id        String   @id @default("singleton")
  data      String   // JSON string with all editable content (incl. theme colors)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

model Customer {
  id        String   @id @default(cuid())
  name      String?
  phone     String   @unique
  email     String?
  city      String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders    Order[]
  leads     Lead[]
}

model Order {
  id          String   @id @default(cuid())
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id])
  productId   String
  productName String
  productPrice String
  size        String?
  quantity    Int      @default(1)
  status      String   @default("pending") // pending | confirmed | shipped | delivered | cancelled
  total       String
  notes       String?
  source      String?  // landing | product_page | cta
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

model Lead {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  email      String
  source     String   @default("newsletter")
  createdAt  DateTime @default(now())

  @@index([email])
}

model PageView {
  id        String   @id @default(cuid())
  path      String
  referrer  String?
  country   String?
  device    String?
  createdAt DateTime @default(now())

  @@index([path])
  @@index([createdAt])
}
